{
  "info": {
    "name": "PROYECTO_FINAL - Abarrotes Express",
    "description": "Pruebas de los endpoints de DummyJSON usados por la aplicación. Ejecutar primero el login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://dummyjson.com"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login correcto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Devuelve token', function () { pm.expect(json.accessToken || json.token).to.be.a('string'); });",
              "pm.collectionVariables.set('token', json.accessToken || json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Inicia sesión y guarda el token en la variable de colección.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"emilyspass\",\n  \"expiresInMins\": 1440\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Login con contraseña incorrecta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 400', function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "description": "Caso de error: la app muestra 'Usuario o contraseña incorrectos'.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"emilys\",\n  \"password\": \"incorrecta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "3. Usuario actual (protegido)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Tiene username', function () { pm.expect(pm.response.json().username).to.eql('emilys'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "Requiere el token en el encabezado Authorization: Bearer.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "name": "4. Usuario actual sin token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        },
        "description": "Caso de error: sin token el servidor responde 401 y la app vuelve al login.",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "5. Productos de abarrotes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Tiene lista de productos', function () { pm.expect(json.products).to.be.an('array').that.is.not.empty; });",
              "pm.test('Cada producto tiene id, title y price', function () { json.products.forEach(function (p) { pm.expect(p).to.have.property('id'); pm.expect(p).to.have.property('title'); pm.expect(p).to.have.property('price'); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/category/groceries?limit=100",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "category",
            "groceries"
          ],
          "query": [
            {
              "key": "limit",
              "value": "100"
            }
          ]
        },
        "description": "Catálogo que muestra la pantalla principal."
      }
    }
  ]
}